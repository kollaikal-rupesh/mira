LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Moss — semantic search / memory (https://docs.moss.dev/docs)
# MOSS_PROJECT_ID / MOSS_PROJECT_KEY are filled in at index/run time (Task 9).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_MEMORY_INDEX_NAME=memory
MOSS_MODEL_ID=moss-minilm

# Photon (iMessage) bridge — the agent sends the escalation dossier and the
# resolution receipt as iMessages by POSTing to the Spectrum send service
# (dummy-moss/, which runs the spectrum-ts SDK; Photon has no Python/REST send).
# Optional: if no recipient is set, the agent reads the message aloud instead.
ESCALATE_URL=http://localhost:8787/send
# Must match ESCALATE_SHARED_SECRET in dummy-moss/.env (optional but recommended).
ESCALATE_SHARED_SECRET=
# Recipients (E.164, e.g. +14155552345). DEMO_PHONE is the fallback for both.
SERVICE_DESK_PHONE=
TECH_PHONE=
DEMO_PHONE=

# --- Qwen LLM (OpenAI-compatible endpoint, e.g. Alibaba DashScope) ---
# If QWEN_API_KEY is set, the agent uses Qwen; otherwise the fast Inference model.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- MiniMax TTS (plugin). If MINIMAX_API_KEY set, agent uses MiniMax; else Cartesia. ---
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
