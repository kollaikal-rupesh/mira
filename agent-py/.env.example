LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Moss — semantic search / memory (https://docs.moss.dev/docs)
# MOSS_PROJECT_ID / MOSS_PROJECT_KEY are filled in at index/run time (Task 9).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_MEMORY_INDEX_NAME=memory
MOSS_MODEL_ID=moss-minilm

# Twilio — used to text the escalation dossier to the service desk.
# Optional: if unset, the agent gracefully reads the dossier summary aloud instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The handset that receives the dossier (E.164, e.g. +14155552345).
# SERVICE_DESK_PHONE is preferred; DEMO_PHONE is accepted as a fallback.
SERVICE_DESK_PHONE=
DEMO_PHONE=
