# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch.
# Moss dispatches explicitly to the Python agent registered as `agent-py`.
AGENT_NAME=agent-py

# Photon (Spectrum) iMessage bridge — used by app/api/escalate/route.ts to send
# the agent's escalation dossier / resolution receipt as an iMessage via the
# spectrum-ts SDK. Find PROJECT_ID / SECRET in your Photon dashboard
# (https://app.photon.codes) project Settings. Server-only — never NEXT_PUBLIC_*.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Optional shared secret; if set, must match ESCALATE_SHARED_SECRET in agent-py/.env.local.
ESCALATE_SHARED_SECRET=

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
