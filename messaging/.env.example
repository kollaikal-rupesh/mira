# Spectrum (Photon) credentials — from your Photon dashboard (https://app.photon.codes).
PROJECT_ID=
PROJECT_SECRET=

# Optional shared secret; if set, the agent must send it as the x-escalate-secret
# header. Must match ESCALATE_SHARED_SECRET in agent-py/.env.local.
ESCALATE_SHARED_SECRET=

# Port the outbound send service listens on (agent posts to /send here).
SEND_PORT=8787
